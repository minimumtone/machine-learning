flowchart TB
  subgraph S1["ステップ1: データ準備"]
    A1["ingestion/generate_extended_data.py<br/>(random.seed(42), 合成1,470エントリ)"] --> A2["db/insert_data.sql"]
    B1["scripts/fetch_oqmd_pure_elements.py<br/>(OQMD REST API, ntypes=1)"] --> B2["db/pure_element_data.json"]
    B2 --> B3["scripts/generate_pure_element_sql.py"] --> B4["db/insert_pure_elements.sql<br/>(89純元素)"]
    C1["scripts/build_mecab_materials_dict.py"] --> C2["llm/mecab_materials.csv / .dic"]
  end

  subgraph S2["ステップ2: DB構築"]
    D1["docker/docker-compose.yml<br/>(PostgreSQL 15)"]
    D2["db/extended_schema.sql → insert_data.sql → insert_pure_elements.sql<br/>(docker-entrypoint-initdb.d 順次投入)"]
    D1 --> D2
    D3["build_transfer_db.py (B) /<br/>build_obfuscated_transfer_db.py (C) /<br/>prepare_mp_transfer.py + build_mp_transfer_db.py (D)"]
  end
  A2 --> D2
  B4 --> D2

  subgraph S3["ステップ3: 評価データセット"]
    E1["evaluation_dataset.jsonl + gold_sql/ + expected_results/<br/>(主評価100クエリ)"]
    E2["expert_evaluation_dataset.jsonl (独立100) /<br/>cte_evaluation_dataset.jsonl (新規CTE 10, 主評価5と合わせ計15)"]
    E3["gen_prototype_evaluation.py →<br/>prototype_evaluation_dataset.jsonl (A, 20)"]
  end

  subgraph S4["ステップ4: 評価実行 (要OPENAI_API_KEY, 非決定的)"]
    F1["eval_ablation_multirun.py --n-runs 5 →<br/>ablation_run_{1..5}.json, ablation_multirun_stats.json"]
    F2["eval_multiaxis_metrics.py → multiaxis_results.json"]
    F3["eval_independent.py --dataset/--output →<br/>independent / cte / prototype _eval_results.json"]
    F4["eval_transfer.py / eval_transfer_obfuscated.py /<br/>eval_mp_transfer.py (B/C/D)"]
    F5["eval_fewshot_sensitivity.py / eval_dict_sensitivity.py /<br/>eval_model_comparison.py / eval_jp_reranker_vh.py"]
  end
  D2 --> S4
  D3 --> F4
  E1 --> F1
  E1 --> F2
  E2 --> F3
  E3 --> F3
  C2 --> S4

  subgraph S5["ステップ5: 統計解析"]
    G1["compute_ablation_stats_v2.py<br/>(n_eff, 正確符号反転p, rank-biserial,<br/>bootstrap 95%CI, シード20260602)"] --> G2["ablation_significance_v2.json"]
  end
  F1 --> G1

  subgraph S6["ステップ6: 集計・図表生成 (決定的)"]
    H1["compute_all_figures.py<br/>(前提: pytest tests/ 134件合格)"] --> H2["paper/paper_data.json (SSOT)"]
    H3["generate_figures.py"] --> H4["paper/figures/*.pdf/png (図6点)"]
  end
  S4 --> H1
  G2 --> H1
  H2 --> H3

  subgraph S7["ステップ7: 数値整合検証・原稿生成"]
    I1["verify_paper_numbers.py --paper-dir paper"]
    I2["LuaLaTeX + BibTeX"]
  end
  H2 --> I1
  H4 --> I2
  I1 --> I2

  subgraph S8["ステップ8: 結果の解釈"]
    J1["表1: Δ / n_eff / 正確p / 効果量 / 95%CI<br/>(n_eff小はCI区間評価, 層別Δは探索的)"]
    J2["Recall + Precision / F1 /<br/>Exact Result-Set Match 併用"]
    J3["合成検証データとOQMD由来実データの区別<br/>(抽出パイプラインの正確性を評価)"]
  end
  I2 --> S8
