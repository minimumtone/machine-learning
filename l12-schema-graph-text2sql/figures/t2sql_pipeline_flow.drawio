          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ============================================================ -->
        <!-- Stage 4b: Few-Shot Store (RAG) -->
        <!-- ============================================================ -->
        <mxCell id="fewshot_store" value="&lt;b&gt;Few-Shot Store&lt;/b&gt;&lt;br&gt;(SQL-as-Few-Shot-Examples)&lt;br&gt;&lt;hr&gt;• 成功 NL→SQL ペア蓄積&lt;br&gt;• TF-IDF cosine 類似検索&lt;br&gt;• 論文からのシード抽出&lt;br&gt;&lt;br&gt;&lt;i&gt;few_shot_examples.json&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
