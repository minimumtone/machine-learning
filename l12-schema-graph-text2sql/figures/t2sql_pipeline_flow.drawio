          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ============================================================ -->
        <!-- Stage 4: SQL Generator -->
        <!-- ============================================================ -->
        <mxCell id="sql_gen" value="&lt;b&gt;SQL Generator&lt;/b&gt;&lt;br&gt;(SQL生成)&lt;br&gt;&lt;hr&gt;• LLM (GPT-4.1-mini)&lt;br&gt;  or Rule-based fallback&lt;br&gt;&lt;br&gt;• Schema-constrained prompt&lt;br&gt;• Few-shot examples 注入&lt;br&gt;• allowed tables/columns/joins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="80" width="230" height="170" as="geometry"/>
