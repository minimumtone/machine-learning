        <!-- ============================================================ -->
        <mxCell id="paper_ext" value="&lt;b&gt;論文シード抽出&lt;/b&gt;&lt;br&gt;(Paper Extraction)&lt;br&gt;&lt;hr&gt;LaTeX → B2/L1₂ 化合物&lt;br&gt;→ NL→SQL シード生成" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
