<mxfile host="app.diagrams.net" modified="2026-05-30" agent="Devin" version="24.0">
  <diagram id="pipeline" name="T2SQL Pipeline Flow">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title1" value="&lt;b&gt;Schema-Graph-Assisted Text-to-SQL Pipeline&lt;/b&gt;&lt;br&gt;with SQL-as-Few-Shot-Examples (RAG Feedback Loop)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="400" y="10" width="800" height="50" as="geometry"/>
        </mxCell>

        <!-- ============================================================ -->
        <!-- Stage 1: NL Query Input -->
        <!-- ============================================================ -->
        <mxCell id="nl_input" value="&lt;b&gt;自然言語クエリ&lt;/b&gt;&lt;br&gt;(Natural Language Input)&lt;br&gt;&lt;br&gt;&lt;i&gt;例: &quot;Feを含む安定なL1₂型&lt;br&gt;化合物を形成エネルギーが&lt;br&gt;低い順に出して&quot;&lt;/i&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="240" height="120" as="geometry"/>
        </mxCell>

        <!-- ============================================================ -->
        <!-- Stage 2: Entity Extractor -->
        <!-- ============================================================ -->
        <mxCell id="entity_ext" value="&lt;b&gt;Entity Extractor&lt;/b&gt;&lt;br&gt;(条件抽出)&lt;br&gt;&lt;hr&gt;• prototype: L12&lt;br&gt;• elements: [Fe]&lt;br&gt;• stability: stable&lt;br&gt;• sort: formation_energy ASC&lt;br&gt;• properties: [lattice_a]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="80" width="220" height="160" as="geometry"/>
        </mxCell>

        <!-- Arrow: NL -> Entity -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" source="nl_input" target="entity_ext" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ============================================================ -->
        <!-- Stage 2b: material_terms.yaml (RAG knowledge) -->
        <!-- ============================================================ -->
        <mxCell id="terms_yaml" value="&lt;b&gt;material_terms.yaml&lt;/b&gt;&lt;br&gt;(材料用語辞書)&lt;br&gt;&lt;hr&gt;• prototype_aliases&lt;br&gt;• stability_terms&lt;br&gt;• property_terms&lt;br&gt;• elements (日英)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="350" y="280" width="200" height="130" as="geometry"/>
        </mxCell>

        <!-- Arrow: terms -> entity -->
        <mxCell id="a_terms" value="参照" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#d6b656;strokeWidth=1.5;" edge="1" source="terms_yaml" target="entity_ext" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ============================================================ -->
        <!-- Stage 3: Schema Linker -->
        <!-- ============================================================ -->
        <mxCell id="schema_link" value="&lt;b&gt;Schema Linker&lt;/b&gt;&lt;br&gt;(スキーマリンク)&lt;br&gt;&lt;hr&gt;条件 → テーブル/カラム&lt;br&gt;マッピング&lt;br&gt;&lt;br&gt;必要テーブル:&lt;br&gt;{material_entry,&lt;br&gt; composition, structure,&lt;br&gt; phase_stability}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="80" width="200" height="170" as="geometry"/>
        </mxCell>

        <!-- Arrow: Entity -> Schema Linker -->
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" source="entity_ext" target="schema_link" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ============================================================ -->
        <!-- Stage 3b: Schema Graph (NetworkX) -->
        <!-- ============================================================ -->
        <mxCell id="schema_graph" value="&lt;b&gt;Schema Graph&lt;/b&gt;&lt;br&gt;(NetworkX DiGraph)&lt;br&gt;&lt;hr&gt;• テーブルノード (7)&lt;br&gt;• カラムノード&lt;br&gt;• FK エッジ&lt;br&gt;• JOINABLE_WITH エッジ&lt;br&gt;&lt;br&gt;&lt;i&gt;DB introspection で&lt;br&gt;自動構築&lt;/i&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="610" y="300" width="220" height="150" as="geometry"/>
        </mxCell>

        <!-- Arrow: Graph -> Linker -->
        <mxCell id="a_graph" value="グラフ探索" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#b85450;strokeWidth=1.5;" edge="1" source="schema_graph" target="schema_link" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ============================================================ -->
        <!-- Stage 3c: Traversal Engine -->
        <!-- ============================================================ -->
        <mxCell id="traversal" value="&lt;b&gt;Traversal Engine&lt;/b&gt;&lt;br&gt;&lt;hr&gt;• shortest_path()&lt;br&gt;• Steiner tree 近似&lt;br&gt;• JOIN経路生成&lt;br&gt;&lt;br&gt;&lt;i&gt;material_entry →&lt;br&gt;composition, structure,&lt;br&gt;phase_stability&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="610" y="480" width="220" height="140" as="geometry"/>
        </mxCell>

        <!-- Arrow: Graph -> Traversal -->
