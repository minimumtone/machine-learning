# Example environment variables for reproducing the paper results.
# Copy this file to .env and fill in the values.  Items ending with _KEY
# are required only for re-running LLM-dependent evaluations.

# PostgreSQL connection (defaults match docker/docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=l12_materials
POSTGRES_USER=l12_user
POSTGRES_PASSWORD=l12_password

# LLM model used for SQL generation and reranking.
LLM_MODEL=gpt-5.5

# OpenAI API key for SQL generation / repair / ablation evaluations.
OPENAI_API_KEY=sk-...

# Optional: separate key for the reranker calls if you want to isolate usage.
# OPENAI_API_KEY_RERANK=sk-...

# Optional: reranker model (OpenAI model ID or sentence-transformers name).
# RERANK_MODEL=gpt-5.5

# Materials Project API key, required only for scripts/build_mp_transfer_db.py.
# MP_API_KEY=...
