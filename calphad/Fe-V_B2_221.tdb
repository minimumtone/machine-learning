$ Fe-V B2_221 CALPHAD Model
$ TDB-file for the thermodynamic assessment of the Fe-V system
$ with B2 ordered phase modeled using 8 sublattices (2x2x1 supercell)
$
$-----------------------------------------------------------------------------
$ 2025.12.13
$ 
$ TDB file created based on CALPHAD-NK methodology
$ Using Neumann-Kopp approximation for temperature dependence
$
$ Reference: Sanchez et al., Phys. Rev. B 54, 8958 (1996)
$ "Experimental and theoretical determination of the metastable Fe-V phase diagram"
$
$ Base parameters from:
$ K.C. Hari Kumar and V. Raghavan, CALPHAD Vol. 15, No. 3, pp. 307-314, 1991
$
$-----------------------------------------------------------------------------
$
 ELEMENT /-   ELECTRON_GAS              0.0000E+00  0.0000E+00  0.0000E+00 !
 ELEMENT FE   BCC_A2                    5.5847E+01  4.4890E+03  2.7280E+01 !
 ELEMENT V    BCC_A2                    5.0941E+01  4.5070E+03  3.0890E+01 !
 ELEMENT VA   VACUUM                    0.0000E+00  0.0000E+00  0.0000E+00 !
$-------------------------------------------------------------------------------
$ FUNCTION FE 
$-------------------------------------------------------------------------------
 FUNCTION GLIQFE 298.15 12040.17-6.55843*T-3.67516E-021*T**7
   +GHSERFE; 1811 Y
   -10838.83+291.302*T-46*T*LN(T); 6000 N !
 FUNCTION GHSERFE 298.15 1225.7+124.134*T-23.5143*T*LN(T)
   -0.00439752*T**2-5.8927E-008*T**3+77359*T**(-1); 1811 Y
   -25383.581+299.31255*T-46*T*LN(T)
   +2.29603E+031*T**(-9); 6000 N !
 FUNCTION GFCCFE 298.15 -236.7+132.416*T-24.6643*T*LN(T)
   -0.00375752*T**2-5.8927E-008*T**3+77359*T**(-1); 1811 Y
   -27097.3963+300.252559*T-46*T*LN(T)
   +2.78854E+031*T**(-9); 6000 N !
$-------------------------------------------------------------------------------
$ FUNCTION V 
$-------------------------------------------------------------------------------
 FUNCTION GFCCVV 298.15 7500+1.7*T+GHSERV; 6000 N !
 FUNCTION GLIQVV 298.15 20764.117-9.455552*T-5.19136E-022*T**7
   +GHSERV; 2183 Y
   22072.354-10.0848*T-6.44389E+031*T**(-9)
   +GHSERV; 6000 N !
 FUNCTION GHSERV 298.15 -7930.43+133.346053*T-24.134*T*LN(T)
   -0.003098*T**2+1.2175E-007*T**3+69460*T**(-1); 790 Y
   -7967.842+143.291093*T-25.9*T*LN(T)
   +6.25E-005*T**2-6.8E-007*T**3; 2183 Y
   -41689.864+321.140783*T-47.43*T*LN(T)
   +6.44389E+031*T**(-9); 4000 N !
$
$-------------------------------------------------------------------------------
 TYPE_DEFINITION % SEQ *!
 DEFINE_SYSTEM_DEFAULT ELEMENT 2 !
 DEFAULT_COMMAND DEF_SYS_ELEMENT VA /- !
 
$-------------------------------------------------------------------------------
$ LIQUID
$-------------------------------------------------------------------------------
 PHASE LIQUID % 1 1 !
 CONSTITUENT LIQUID :FE,V:!
 PARAMETER G(LIQUID,FE;0)   298.15 +GLIQFE;           6000 N !
 PARAMETER G(LIQUID,V;0)    298.15 +GLIQVV;           4000 N !
 PARAMETER G(LIQUID,FE,V;0) 298.15 -35963+10.489*T;   6000 N !
 PARAMETER G(LIQUID,FE,V;1) 298.15 -4935+6.290*T;     6000 N !
$-------------------------------------------------------------------------------
$ FCC_A1
$-------------------------------------------------------------------------------
 TYPE_DEFINITION ' GES A_P_D FCC_A1 MAGNETIC -3  0.28!
 PHASE FCC_A1 %' 1 1 !
 CONSTITUENT FCC_A1 :FE,V:!
 PARAMETER G(FCC_A1,FE;0)     298.15 +GFCCFE;        6000 N !
 PARAMETER G(FCC_A1,V;0)      298.15 +GFCCVV;        4000 N !
 PARAMETER G(FCC_A1,FE,V;0)   298.15 -15260+1.765*T; 6000 N !
 PARAMETER TC(FCC_A1,FE;0)    298.15 -201;           6000 N !
 PARAMETER BMAGN(FCC_A1,FE;0) 298.15 -2.1;           6000 N !
$-------------------------------------------------------------------------------
$ BCC_A2
$-------------------------------------------------------------------------------
 TYPE_DEFINITION & GES A_P_D BCC_A2 MAGNETIC -1  0.4!
 PHASE BCC_A2 %& 1 1 !
 CONSTITUENT BCC_A2 :FE,V:!
 PARAMETER G(BCC_A2,FE;0)       298.15 +GHSERFE;       6000 N !
 PARAMETER G(BCC_A2,V;0)        298.15 +GHSERV;       4000 N !
 PARAMETER G(BCC_A2,FE,V;0)     298.15 -21427+6.846*T; 6000 N !
 PARAMETER G(BCC_A2,FE,V;1)     298.15 +7345-1.509*T;  6000 N !
 PARAMETER TC(BCC_A2,FE;0)      298.15 +1043;          6000 N !
 PARAMETER TC(BCC_A2,FE,V;0)    298.15 -110;           6000 N !
 PARAMETER TC(BCC_A2,FE,V;1)    298.15 +3075;          6000 N !
 PARAMETER TC(BCC_A2,FE,V;2)    298.15 +808;           6000 N !
 PARAMETER TC(BCC_A2,FE,V;3)    298.15 -2169;          6000 N !
 PARAMETER BMAGN(BCC_A2,FE;0)   298.15 +2.22;          6000 N !
 PARAMETER BMAGN(BCC_A2,FE,V;0) 298.15 -2.26;          6000 N !
$-------------------------------------------------------------------------------
$ SIGMA
$-------------------------------------------------------------------------------
 PHASE SIGMA % 3 8 4 18 !
 CONSTITUENT SIGMA :FE:V:FE,V:!
 PARAMETER G(SIGMA,FE:V:FE;0) 298.15 +8*GFCCFE+4*GHSERV+18*GHSERFE
   -163218+41.607*T; 6000 N !
 PARAMETER G(SIGMA,FE:V:V;0)  298.15 +8*GFCCFE+4*GHSERV+18*GHSERV
   -183967-43.718*T; 6000 N !
$-------------------------------------------------------------------------------
$ B2_221 - 8 sublattice B2 ordered phase (2x2x1 supercell)
$ Based on CALPHAD-NK methodology with Neumann-Kopp approximation
$ G(endmember) = n_Fe*GHSERFE + n_V*GHSERV + dH_f(0K)
$ where dH_f(0K) is the formation enthalpy from DFT at 0K
$-------------------------------------------------------------------------------
 PHASE B2_221 % 8 1 1 1 1 1 1 1 1 !
 CONSTITUENT B2_221 :FE,V:FE,V:FE,V:FE,V:FE,V:FE,V:FE,V:FE,V:!
$
$ Endmember Gibbs energies
$ Energy = n_Fe*GHSERFE + n_V*GHSERV + GFORM_xxx
$ GFORM_xxx is the formation energy (dummy variable, to be fitted)
$
$ Formation energy functions (256 individual functions for DFT data)
$ GFORM_xxx represents the formation energy contribution for each configuration
$ Values are placeholders (0) - to be replaced with actual DFT data
$
 FUNCTION GFORM_0V_001 298.15 0; 6000 N !
