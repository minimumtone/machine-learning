 TYPE_DEFINITION % SEQ *!
 DEFINE_SYSTEM_DEFAULT ELEMENT 2 !
 DEFAULT_COMMAND DEF_SYS_ELEMENT VA /- !
 
$-------------------------------------------------------------------------------
$ LIQUID
$-------------------------------------------------------------------------------
 PHASE LIQUID % 1 1 !
 CONSTITUENT LIQUID :FE,V:!
 PARAMETER G(LIQUID,FE;0)   298.15 +GLIQFE;           6000 N !
 PARAMETER G(LIQUID,V;0)    298.15 +GLIQVV;           4000 N !
 PARAMETER G(LIQUID,FE,V;0) 298.15 -35963+10.489*T;   6000 N !
 PARAMETER G(LIQUID,FE,V;1) 298.15 -4935+6.290*T;     6000 N !
$-------------------------------------------------------------------------------
$ FCC_A1
$-------------------------------------------------------------------------------
 TYPE_DEFINITION ' GES A_P_D FCC_A1 MAGNETIC -3  0.28!
 PHASE FCC_A1 %' 1 1 !
 CONSTITUENT FCC_A1 :FE,V:!
 PARAMETER G(FCC_A1,FE;0)     298.15 +GFCCFE;        6000 N !
 PARAMETER G(FCC_A1,V;0)      298.15 +GFCCVV;        4000 N !
 PARAMETER G(FCC_A1,FE,V;0)   298.15 -15260+1.765*T; 6000 N !
 PARAMETER TC(FCC_A1,FE;0)    298.15 -201;           6000 N !
 PARAMETER BMAGN(FCC_A1,FE;0) 298.15 -2.1;           6000 N !
$-------------------------------------------------------------------------------
$ BCC_A2
$-------------------------------------------------------------------------------
 TYPE_DEFINITION & GES A_P_D BCC_A2 MAGNETIC -1  0.4!
 PHASE BCC_A2 %& 1 1 !
 CONSTITUENT BCC_A2 :FE,V:!
 PARAMETER G(BCC_A2,FE;0)       298.15 +GHSERFE;       6000 N !
 PARAMETER G(BCC_A2,V;0)        298.15 +GHSERV;       4000 N !
 PARAMETER G(BCC_A2,FE,V;0)     298.15 -21427+6.846*T; 6000 N !
 PARAMETER G(BCC_A2,FE,V;1)     298.15 +7345-1.509*T;  6000 N !
 PARAMETER TC(BCC_A2,FE;0)      298.15 +1043;          6000 N !
 PARAMETER TC(BCC_A2,FE,V;0)    298.15 -110;           6000 N !
 PARAMETER TC(BCC_A2,FE,V;1)    298.15 +3075;          6000 N !
 PARAMETER TC(BCC_A2,FE,V;2)    298.15 +808;           6000 N !
 PARAMETER TC(BCC_A2,FE,V;3)    298.15 -2169;          6000 N !
 PARAMETER BMAGN(BCC_A2,FE;0)   298.15 +2.22;          6000 N !
 PARAMETER BMAGN(BCC_A2,FE,V;0) 298.15 -2.26;          6000 N !
$-------------------------------------------------------------------------------
$ SIGMA
$-------------------------------------------------------------------------------
 PHASE SIGMA % 3 8 4 18 !
 CONSTITUENT SIGMA :FE:V:FE,V:!
 PARAMETER G(SIGMA,FE:V:FE;0) 298.15 +8*GFCCFE+4*GHSERV+18*GHSERFE
   -163218+41.607*T; 6000 N !
 PARAMETER G(SIGMA,FE:V:V;0)  298.15 +8*GFCCFE+4*GHSERV+18*GHSERV
   -183967-43.718*T; 6000 N !
$-------------------------------------------------------------------------------
$ B2_221 - 8 sublattice B2 ordered phase (2x2x1 supercell)
$ Based on CALPHAD-NK methodology with Neumann-Kopp approximation
$ G(endmember) = n_Fe*GHSERFE + n_V*GHSERV + dH_f(0K) + GMAG_n(T)
$ where GHSERFE/GHSERV are SGTE SER references
$ GMAG_n(T) = composition-dependent BCC magnetic G (IHJ model with TC(x), beta(x))
$ Reference state aligned with BCC_A2 including magnetic Gibbs energy
$ dH_f(0K) is the DFT formation enthalpy at 0K (GFxVyyy, unchanged)
$-------------------------------------------------------------------------------
 PHASE B2_221 % 8 1 1 1 1 1 1 1 1 !
 CONSTITUENT B2_221 :FE,V:FE,V:FE,V:FE,V:FE,V:FE,V:FE,V:FE,V:!
$
