





















@@@ 01.tcm 
go da 
sw user ./Gver.6.60.TDB
rej sys 
d-sys Fe Ni Si Mn Mo Cr C P S N  
rej pha CR3SI1_S CR3SI1_L
get
go p-3 
s-c N=1 P=1e5 T=748.15	  
s-c X(Ni)=0.09919 X(Si)=0.00997 X(Mn)=0.0141 X(Mo)=0.00029 X(Cr)=0.21971 X(C)=0.0005 X(P)=0.00035 X(S)=0.00017 X(N)=0.0011
ad-op glo y 20000
c-e
c-e 
li-eq 01S.PLE AXCP
s-c T=1800
c-e
c-trans G_PHASE T
li-eq 01T.PLE AXCP

back
back

